FROM oven/bun:1 AS build

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifests first so dependency installation stays cacheable.
COPY package.json bun.lock tsconfig.json ./
COPY packages/core/package.json packages/core/
COPY packages/daemon/package.json packages/daemon/
COPY packages/cli/package.json packages/cli/
COPY packages/relay/package.json packages/relay/
COPY packages/dashboard/package.json packages/dashboard/

RUN bun install --frozen-lockfile

# Copy the sources needed to compile the CLI daemon entrypoint.
COPY packages/core/src packages/core/src
COPY packages/daemon/src packages/daemon/src
COPY packages/cli/src packages/cli/src
COPY packages/relay/src packages/relay/src

RUN bun build --compile packages/cli/src/index.ts --outfile /app/orka

FROM debian:bookworm-slim AS runtime

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    tmux git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /data/logs /data/worktrees /data/scripts

COPY --from=build /app/orka /usr/local/bin/orka

ENV ORKA_HOME=/data

EXPOSE 7394

ENTRYPOINT ["/usr/local/bin/orka", "serve"]
CMD ["--port", "7394", "--host", "0.0.0.0"]
