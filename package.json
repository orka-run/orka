{
  "name": "orka",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:di": "bun run scripts/lint-di.ts",
    "lint:tests": "bun run scripts/lint-tests.ts",
    "check": "bun run typecheck && bun run lint && bun run lint:di && bun run lint:tests",
    "test": "bun test packages/",
    "test:coverage": "bun test --coverage packages/",
    "test:e2e": "bash scripts/test-e2e-parallel.sh"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.6.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-trace-base": "^2.6.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.4.0",
    "eslint": "^10.0.3",
    "lefthook": "^2.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}
