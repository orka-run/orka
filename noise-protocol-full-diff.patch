+  const pubB64 = Buffer.from(info.publicKey).toString("base64url");
+  const privB64 = Buffer.from(info.privateKey).toString("base64url");
+  writeFileSync(join(dir, `${name}.noise.pub`), pubB64, { mode: 0o644 });
