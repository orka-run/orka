+ * Save a Noise keypair to disk.
+ * Files: <name>.noise.pub (base64url public key) and <name>.noise.key (base64url private key).
+ */
+export function saveNoiseKeyPair(orkaHome: string, name: string, info: NoiseKeyInfo): void {
